# Rajomon-HTTP — Environment Variable Reference
# Copy this file to .env and adjust values for your local environment.
# This file IS committed. The actual .env file is NOT committed (see .gitignore).
#
# PURPOSE: Keeps tunable experiment parameters out of hardcoded source code.
# There are no external API keys here — all components run locally.

# ── Phase 1: Docker Compose project name ──────────────────────────────────────
# Keeps container/network names consistently namespaced across both teammates.
COMPOSE_PROJECT_NAME=rajomon-http

# ── Phase 1: Benchmark application entry port ────────────────────────────────
# The port DeathStarBench's nginx-thrift front-end is exposed on (host:container 8080:8080).
# Used for direct baseline curl tests in Phase 1 exit conditions.
SOCIAL_NETWORK_NGINX_PORT=8080

# ── Phase 2+: Sidecar identification ─────────────────────────────────────────
# Set per-sidecar instance in docker-compose.yml; shown here for documentation.
# RAJOMON_SERVICE_NAME=compose-post-service

# ── Phase 2+: Sidecar listen/upstream addresses ──────────────────────────────
# RAJOMON_LISTEN_ADDR=:9464
# RAJOMON_UPSTREAM_ADDR=compose-post-service:9090

# ── Phase 3+: Admission engine pricing parameters ────────────────────────────
# Base price — minimum price any service charges even at zero load.
RAJOMON_BASE_PRICE=1.0
# Price scale factor — how steeply price rises per in-flight request.
RAJOMON_PRICE_SCALE_FACTOR=0.5
