# Rajomon-HTTP — Environment Variable Reference
# Copy this file to .env and adjust values for your local environment.
# This file IS committed. The actual .env file is NOT committed (see .gitignore).
#
# PURPOSE: Keeps tunable experiment parameters out of hardcoded source code.
# There are no external API keys here — all components run locally.

# ── Docker Compose project name ───────────────────────────────────────────────
# Keeps container/network names consistently namespaced.
COMPOSE_PROJECT_NAME=rajomon-http

# ── Sidecar admission pricing parameters ─────────────────────────────────────
# Base price — minimum price any service charges even at zero load.
# Applied to ALL 5 sidecars via the x-sidecar-defaults anchor.
RAJOMON_BASE_PRICE=1.0

# Price scale factor — how steeply price rises per in-flight request.
# At 0.5: price = 1.0 + 0.5 × in_flight
# Increase to make admission control more aggressive under load.
RAJOMON_PRICE_SCALE_FACTOR=0.5

# ── Grafana admin credentials ─────────────────────────────────────────────────
# Change before exposing Grafana to a network.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=rajomon

# ── Envoy Gateway ports ───────────────────────────────────────────────────────
# Start with: docker compose --profile permissive up -d
#          or docker compose --profile hardened  up -d
ENVOY_GATEWAY_PORT=10000
ENVOY_ADMIN_PORT=9901
