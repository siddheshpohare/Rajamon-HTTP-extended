{
  "title": "Rajomon-HTTP — Sidecar Fleet Overview",
  "uid": "rajomon-fleet",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["rajomon"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests (all sidecars)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(rajomon_sidecar_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rejection Rate (all sidecars)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(rajomon_sidecar_requests_total{verdict=\"reject_insufficient_tokens\"}[1m])) / sum(rate(rajomon_sidecar_requests_total[1m]))",
          "legendFormat": "rejection %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total In-Flight (all sidecars)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rajomon_sidecar_in_flight_requests)",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request Rate by Service & Verdict",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(rajomon_sidecar_requests_total[1m])",
          "legendFormat": "{{service_name}} / {{verdict}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "In-Flight Requests per Sidecar",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rajomon_sidecar_in_flight_requests",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Admission Price p50 / p95 / p99 per Service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(rajomon_sidecar_admission_price_bucket[1m]))",
          "legendFormat": "p50 {{service_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(rajomon_sidecar_admission_price_bucket[1m]))",
          "legendFormat": "p95 {{service_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(rajomon_sidecar_admission_price_bucket[1m]))",
          "legendFormat": "p99 {{service_name}}"
        }
      ]
    }
  ]
}
